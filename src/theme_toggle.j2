<button id="theme_toggle" class="theme_toggle" type="button" title="Toggle dark mode."
aria-label="Toggle dark mode" onclick="toggle_theme()">
  <svg class="theme_icon sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="5"/>
    <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <line x1="12" y1="2"    x2="12" y2="4.5"/>
      <line x1="12" y1="19.5" x2="12" y2="22"/>
      <line x1="2"    y1="12" x2="4.5" y2="12"/>
      <line x1="19.5" y1="12" x2="22"  y2="12"/>
      <line x1="4.9"  y1="4.9"  x2="6.7" y2="6.7"/>
      <line x1="17.3" y1="17.3" x2="19.1" y2="19.1"/>
      <line x1="4.9"  y1="19.1" x2="6.7" y2="17.3"/>
      <line x1="17.3" y1="6.7"  x2="19.1" y2="4.9"/>
    </g>
  </svg>
  <svg class="theme_icon moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12 3a9 9 0 1 0 9 9 7 7 0 1 1-9-9z"/>
  </svg>
</button>
